# ─────────────────────────────────────────────────────────────
#  Code Review Agent — Multi-Provider LLM Configuration
# ─────────────────────────────────────────────────────────────

# ── LLM Provider switch ───────────────────────────────────────
# Options: copilot | claude | openai | ollama
LLM_PROVIDER=ollama

# ── GitHub Copilot (LLM_PROVIDER=copilot) ────────────────────
GITHUB_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COPILOT_MODEL=claude-sonnet-4-5

# ── Anthropic Claude (LLM_PROVIDER=claude) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (LLM_PROVIDER=openai) ─────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ── Ollama / self-hosted (LLM_PROVIDER=ollama) ───────────────
OLLAMA_BASE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_MODEL=deepseek-coder-v2
OLLAMA_TIMEOUT=120

# ── GitLab ────────────────────────────────────────────────────
GITLAB_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITLAB_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Agent behaviour ───────────────────────────────────────────
MAX_DIFF_LINES=2000
MIN_SEVERITY_TO_COMMENT=low
POST_INLINE_COMMENTS=true
POST_SUMMARY_COMMENT=true

# ── Enable/disable individual review agents ───────────────────
ENABLE_CODE_QUALITY=true
ENABLE_SECURITY=true
ENABLE_PERFORMANCE=true
ENABLE_DOCUMENTATION=true

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

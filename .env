# ─────────────────────────────────────────────────────────────
#  Code Review Agent — Multi-Provider LLM Configuration
# ─────────────────────────────────────────────────────────────

# ── LLM Provider switch ───────────────────────────────────────
# Options: copilot | claude | openai | ollama
LLM_PROVIDER=ollama

# ── GitHub Copilot (LLM_PROVIDER=copilot) ────────────────────
GITHUB_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COPILOT_MODEL=claude-sonnet-4-5

# ── Anthropic Claude (LLM_PROVIDER=claude) ───────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (LLM_PROVIDER=openai) ─────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ── Ollama / self-hosted (LLM_PROVIDER=ollama) ───────────────
OLLAMA_BASE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_TIMEOUT=600

# ── GitLab ────────────────────────────────────────────────────
# One or more GitLab servers, keyed by a short name of your choosing (e.g.
# "gitlab_com", "internal"). That name is used in the webhook URL
# (/webhook/gitlab/<name>) and in manual /review requests, so the agent knows
# which server + token to use. Must be valid JSON — wrapped in single quotes
# so it can span multiple lines (python-dotenv keeps everything between the
# quotes, newlines included, as one value).
GITLAB_INSTANCES='{
  "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx": {
    "url": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "token": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "webhook_secret": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy": {
    "url": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
    "token": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
    "webhook_secret": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
  }
}'

# ── Agent behaviour ───────────────────────────────────────────
MAX_DIFF_LINES=10000
MIN_SEVERITY_TO_COMMENT=low
POST_INLINE_COMMENTS=true
POST_SUMMARY_COMMENT=true
POST_PROGRESS_COMMENT=true
POST_FIX_SUGGESTIONS=true

# ── Enable/disable individual review agents ───────────────────
ENABLE_CODE_QUALITY=true
ENABLE_SECURITY=true
ENABLE_PERFORMANCE=true
ENABLE_DOCUMENTATION=true

# ── Execution mode (CPU/GPU) — see README "Execution Mode" ─────
# auto detects a GPU via nvidia-smi and picks gpu/cpu accordingly; cpu forces
# everything below to run one at a time regardless of the MAX_PARALLEL_* values.
EXECUTION_MODE=auto
MAX_PARALLEL_REVIEWS=1
MAX_PARALLEL_ANALYZERS=1
MAX_PARALLEL_LLM_REQUESTS=1

# ── Static analysis tools (installed on this server) ───────────
ENABLE_STATIC_ANALYSIS=true
CLONE_FOR_STATIC_ANALYSIS=true
DOTNET_CMD=dotnet
ESLINT_CMD=eslint
RUFF_CMD=ruff
CLANG_TIDY_CMD=clang-tidy
SPOTBUGS_CMD=spotbugs
SPOTBUGS_CLASSES_DIRS=target/classes,build/classes/java/main

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Dashboard login (Active Directory) ─────────────────────────
# THIS DEV BOX: left off so the dashboard stays reachable without a domain
# controller. Set AUTH_ENABLED=true and fill LDAP_SERVER/LDAP_DOMAIN below on
# the test host and in production — see .env.example for the full set.
AUTH_ENABLED=false
LDAP_SERVER=
LDAP_DOMAIN=
LDAP_BASE_DN=
LDAP_REQUIRED_GROUP=
SESSION_SECRET=eCUTqAKt9cZhOYpeHtkvlDjzK9-JXnGB2IvgTKtRlM0m9Fy9o-3WtGszHb_wXj8P
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
DASHBOARD_API_TOKEN=

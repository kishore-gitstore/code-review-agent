# ─────────────────────────────────────────────────────────────
#  Code Review Agent — Multi-Provider LLM Configuration
#  Copy this file to .env and fill in real values. .env is
#  git-ignored — never commit real tokens/keys.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider switch ───────────────────────────────────────
# Options: copilot | claude | openai | ollama
LLM_PROVIDER=ollama

# ── GitHub Copilot (LLM_PROVIDER=copilot) ────────────────────
GITHUB_TOKEN=
COPILOT_MODEL=claude-sonnet-4-5

# ── Anthropic Claude (LLM_PROVIDER=claude) ───────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (LLM_PROVIDER=openai) ─────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Ollama / self-hosted (LLM_PROVIDER=ollama) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder:latest
OLLAMA_TIMEOUT=600

# ── GitLab ────────────────────────────────────────────────────
# One or more GitLab servers, keyed by a short name of your choosing (e.g.
# "gitlab_com", "internal"). That name is used in the webhook URL
# (/webhook/gitlab/<name>) and in manual /review requests, so the agent knows
# which server + token to use. Must be valid JSON — wrapped in single quotes
# so it can span multiple lines (python-dotenv keeps everything between the
# quotes, newlines included, as one value).
GITLAB_INSTANCES='{
  "gitlab_com": {
    "url": "https://gitlab.com",
    "token": "glpat-xxxxxxxxxxxxxxxxxxxx",
    "webhook_secret": "change-me"
  }
}'

# ── Agent behaviour ───────────────────────────────────────────
MAX_DIFF_LINES=2000
MIN_SEVERITY_TO_COMMENT=low
POST_INLINE_COMMENTS=true
POST_SUMMARY_COMMENT=true
# Post code fixes as GitLab "Apply suggestion" blocks (one-click commit).
# false = show fixes as read-only code blocks.
POST_FIX_SUGGESTIONS=true
POST_PROGRESS_COMMENT=true

# ── Enable/disable individual review agents ───────────────────
ENABLE_CODE_QUALITY=true
ENABLE_SECURITY=true
ENABLE_PERFORMANCE=true
ENABLE_DOCUMENTATION=true

# ── Execution mode (CPU/GPU) — see README "Execution Mode" ─────
# auto detects a GPU via nvidia-smi and picks gpu/cpu accordingly; cpu forces
# everything below to run one at a time regardless of the MAX_PARALLEL_* values.
EXECUTION_MODE=auto
MAX_PARALLEL_REVIEWS=1
MAX_PARALLEL_ANALYZERS=1
MAX_PARALLEL_LLM_REQUESTS=1

# ── Static analysis tools (installed on this server) ───────────
ENABLE_STATIC_ANALYSIS=true
CLONE_FOR_STATIC_ANALYSIS=true
STATIC_ANALYSIS_TIMEOUT=60
DOTNET_CMD=dotnet
ESLINT_CMD=eslint
RUFF_CMD=ruff
CARGO_CMD=cargo
CLANG_TIDY_CMD=clang-tidy
CLANG_TIDY_ARGS=-- -std=c++17
SPOTBUGS_CMD=spotbugs
SPOTBUGS_CLASSES_DIRS=target/classes,build/classes/java/main

# ── Dashboard login (Active Directory over LDAP) ──────────────
# Guards the reporting surface only: the dashboard page, the report APIs, and
# the endpoints that start or cancel a review. GitLab webhooks are NOT behind
# it — they authenticate with their own secret above, and a hook can't log in.
#
# false leaves the dashboard readable by anyone who can reach the port. Only
# do that on a dev box.
AUTH_ENABLED=true

# Domain controller. Bare host, host:port, or a URL. ldaps:// forces TLS
# regardless of LDAP_USE_SSL — plain LDAP sends the password in clear text.
LDAP_SERVER=ldaps://dc01.corp.local
LDAP_PORT=0
LDAP_USE_SSL=true
LDAP_TIMEOUT=10

# How a bare login name becomes something AD will bind as.
#   upn  -> name@LDAP_DOMAIN            (most common)
#   ntlm -> LDAP_NETBIOS_DOMAIN\name    (older domains / no UPN suffix)
# A name the user types already qualified ("me@corp.local", "CORP\me") is
# passed through untouched either way.
LDAP_BIND_STYLE=upn
LDAP_DOMAIN=corp.local
LDAP_NETBIOS_DOMAIN=

# Looked up after the bind, for the display name and group membership.
# Optional: leave LDAP_BASE_DN empty and logins still work — you just lose the
# real name in the UI, and LDAP_REQUIRED_GROUP stops being usable.
LDAP_BASE_DN=DC=corp,DC=local
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))

# Restrict the dashboard to one AD group. Empty = any account that can bind.
# A bare CN matches direct membership; a full DN also matches nested groups.
LDAP_REQUIRED_GROUP=

# Who may open the Configuration page and start/stop the review service.
# Comma-separated AD usernames and/or an AD group (CN). Both empty = nobody is
# an admin while AUTH_ENABLED=true.
ADMIN_USERS=
ADMIN_GROUP=

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave it empty and a random one is generated per process — logins then die
# on every service restart and won't work across multiple instances.
SESSION_SECRET=
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=cra_session
# Set true once the dashboard is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional shared secret for callers with no browser (CI, monitoring), sent as
# an X-API-Token header. Empty disables it.
DASHBOARD_API_TOKEN=

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
